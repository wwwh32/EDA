eva-WzbBtSF1Ve\"/><link rel=\"canonical\" href=\"https://oshwhub.com/search\"/><link rel=\"icon\" href=\"https://static.oshwhub.com/web-assets/oshwhub/favicon.ico?v=1791882941887\"/><meta property=\"og:image\" content=\"https://static.oshwhub.com/web-assets/oshwhub/images/header-footer/logo.png?v=1791882941887\"/><link rel=\"preload\" as=\"fetch\" crossorigin=\"anonymous\" href=\"https://static.oshwhub.com/web-assets/oshwhub/sprites/sprite.svg?v=1791882941887\"/><meta name=\"data-jspm\" content=\"hub\"/><meta name=\"body-data-jspm\" content=\"ss\"/><meta name=\"jlc:title\" content=\"搜索页\"/><script>(self.__next_s=self.__next_s||[]).push([0,{\"suppressHydrationWarning\":true,\"children\":\"window.__apmbl = {\\n  url: 'https://datasink.jlc.com/monitor/logs',\\n  bid: 'EDA',\\n  appId: 'eda-hub-pc',\\n  siteId: 'eda-oshwhub',\\n  appName: 'oshwhub-web',\\n  env: 'undefined',\\n  apmConfig: '/monitor-config',\\n  // 关闭 SDK 自动启动（safeModifyDOM 启发式），改由 hydration 完成后调 instrument() 启动（见 app/layout.tsx）\\n  autoInstrument: false,\\n  domains: [],\\n};\",\"id\":\"apm-script-init\"}])</script><script>(self.__next_s=self.__next_s||[]).push([\"https://static.jlc.com/js/fe-monitor/prod/1.3.5/monitor.js\",{\"suppressHydrationWarning\":true,\"id\":\"apm-script\"}])</script><script>(self.__next_s=self.__next_s||[]).push([\"https://static.jlc.com/js/monitor-sdk/apps/prod/eda-hub-pc/oshwhub-web/jlc-apm-sdk.js\",{}])</script><script>(self.__next_s=self.__next_s||[]).push([0,{\"children\":\"(function() {\\n  function waitForSDK() {\\n    if (window.jlcTrack && window.jlcTrack.client) {\\n      // 初始化插件\\n      window.jlcTrack.client.use(window.jlcTrack.exposePlugin());\\n      // 设置 beforeReportHook，确保 args2 在每次上报时都有\\n      window.jlcTrack.client.setBeforeReportHook(function(data) {\\n        data.args2 = function() {\\n          const VISITOR_ID_KEY = 'oshwhub_visitor_id';\\n          const VISITOR_ID_COOKIE_KEY = 'REMOVED';\\n          const COOKIE_EXPIRE_DAYS = 365 * 2;\\n\\n          function getCookie(name) {\\n            const nameEQ = name + '=';\\n            const ca = document.cookie.split(';');\\n            for (let i = 0; i < ca.length; i++) {\\n              let c = ca[i];\\n              while (c.charAt(0) === ' ') c = c.substring(1);\\n              if (c.indexOf(nameEQ) === 0) return c.substring(nameEQ.length);\\n            }\\n            return null;\\n          }\\n\\n          function setCookie(name, value, days) {\\n            const expires = new Date();\\n            expires.setTime(expires.getTime() + days * 24 * 60 * 60 * 1000);\\n            document.cookie = name + '=' + value + ';expires=' + expires.toUTCString() + ';path=/;SameSite=Lax';\\n          }\\n\\n          let visitorId = getCookie(VISITOR_ID_COOKIE_KEY);\\n          if (!visitorId) visitorId = localStorage.getItem(VISITOR_ID_KEY);\\n          if (!visitorId) {\\n            visitorId = 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, function(c) {\\n              var r = Math.random() * 16 | 0;\\n              var v = c === 'x' ? r : (r & 0x3) | 0x8;\\n              return v.toString(16);\\n            });\\n            setCookie(VISITOR_ID_COOKIE_KEY, visitorId, COOKIE_EXPIRE_DAYS);\\n            localStorage.setItem(VISITOR_ID_KEY, visitorId);\\n          }\\n          return visitorId;\\n        }();\\n        return data;\\n      });\\n    } else {\\n      setTimeout(waitForSDK, 50);\\n    }\\n  }\\n  waitForSDK();\\n})();\",\"id\":\"track-sdk-init\"}])</script><script src=\"https://static.oshwhub.com/web/oshwhub/_next/static/chunks/polyfills-42372ed130431b0a.js\" noModule=\"\"></script><style id=\"antd-cssinjs\" data-rc-order=\"prepend\" data-rc-priority=\"-1000\">:where(.css-ff4vvd) a{color:#1677ff;text-decoration:none;background-color:transparent;outline:none;cursor:pointer;transition:color 0.3s;-webkit-text-decoration-skip:objects;}:where(.css-ff4vvd) a:hover{color:#69b1ff;}:where(.css-ff4vvd) a:active{color:#0958d9;}:where(.css-ff4vvd) a:a