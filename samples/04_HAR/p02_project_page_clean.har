:"sec-ch-ua-platform","value":"\"Windows\""},{"name":"sec-fetch-dest","value":"empty"},{"name":"sec-fetch-mode","value":"cors"},{"name":"sec-fetch-site","value":"same-origin"},{"name":"user-agent","value":"Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/132.0.0.0 Safari/537.36"}],"queryString":[{"name":"sort","value":"time"},{"name":"page","value":"1"},{"name":"pageSize","value":"10"}],"cookies":[],"headersSize":-1,"bodySize":0},"response":{"status":200,"statusText":"","httpVersion":"http/2.0","headers":[{"name":"content-encoding","value":"br"},{"name":"content-type","value":"application/json"},{"name":"date","value":"Sun, 18 Oct 2026 15:59:00 GMT"},{"name":"j-trace-id","value":"22e527bb080a4af8810e4b0816c5e657"},{"name":"server","value":"CW"},{"name":"strict-transport-security","value":"max-age=86400"},{"name":"via","value":"CHN-SH-CT13-CACHE30[47],CHN-SH-CT13-CACHE30[ovl,45]"},{"name":"x-ccdn-req-id-46b1","value":"61cd1f7f5cab72ce4c08b66106841a81"},{"name":"x-request-id","value":"X-LC-ID-35ztzfsUekLvAA=="}],"cookies":[],"content":{"size":7837,"mimeType":"application/json","text":"{\"success\":true,\"code\":0,\"result\":{\"page\":1,\"pageSize\":10,\"total\":6,\"totalPage\":1,\"all\":14,\"lists\":[{\"uuid\":\"30ac63b182354615aeb4819603cf04ca\",\"comment_uuid\":null,\"parent_uuid\":null,\"content\":\"EN引脚不需要加限流电阻，引脚耐压17V对你这个绰绰有余，而且内部有1M的下拉电阻\",\"creator\":{\"uuid\":\"b816e73397a8422c9e49d9d7ceaa4df4\",\"username\":\"shuyer\",\"nickname\":\"shuyer\",\"avatar\":\"/image/avatar-default.png\"},\"created_at\":\"2026-03-06 10:41:48\",\"like\":0,\"is_like\":false,\"replies\":[]},{\"uuid\":\"0a8d18401a8346da862c30c7b7952990\",\"comment_uuid\":null,\"parent_uuid\":null,\"content\":\"烧了五个了，检查了电路没问题和实例差不多就电感换成10UH，输入输出都加了22UF电容，找不到任何问题\",\"creator\":{\"uuid\":\"44c63b9cb2384fcbbef0a9b1094e1740\",\"username\":\"arrebol0505\",\"nickname\":\"Arrebol0505\",\"avatar\":\"/image/avatar-default.png\"},\"created_at\":\"2024-08-28 10:11:32\",\"like\":0,\"is_like\":false,\"replies\":[{\"uuid\":\"8b0c3a6ba5354948b4dbf5f2f637d25b\",\"comment_uuid\":\"0a8d18401a8346da862c30c7b7952990\",\"parent_uuid\":\"0a8d18401a8346da862c30c7b7952990\",\"content\":\"可能过流了，MT2492性能其实不怎么样\",\"creator\":{\"uuid\":\"bd44fc34722f4b89a8a7fda0fb77ca7b\",\"username\":\"carele\",\"nickname\":\"Carele\",\"avatar\":\"//image.lceda.cn/avatars/2024/7/ugQSCJo2x80pyZIIgzXIizMsNWlmvKa19drQSUuS.png\"},\"created_at\":\"2024-08-28 23:56:09\",\"to_user\":{\"uuid\":\"44c63b9cb2384fcbbef0a9b1094e1740\",\"username\":\"arrebol0505\",\"nickname\":\"Arrebol0505\",\"avatar\":\"/image/avatar-default.png\"},\"like\":0,\"is_like\":false},{\"uuid\":\"f0cbee4354b34d859df29ce8ba6e425d\",\"comment_uuid\":\"8b0c3a6ba5354948b4dbf5f2f637d25b\",\"parent_uuid\":\"0a8d18401a8346da862c30c7b7952990\",\"content\":\"不会啊60ma,上电就发烫，EN引脚没有使能就发烫了。有没有其它好点的推荐<img title=\\\"点击查看大图\\\" src=\\\"//image.lceda.cn/oshwhub/5a3dd2beda26428590f9494e33f198f3.png\\\" alt=\\\"\\\" />\",\"creator\":{\"uuid\":\"44c63b9cb2384fcbbef0a9b1094e1740\",\"username\":\"arrebol0505\",\"nickname\":\"Arrebol0505\",\"avatar\":\"/image/avatar-default.png\"},\"created_at\":\"2024-08-29 09:38:22\",\"to_user\":{\"uuid\":\"bd44fc34722f4b89a8a7fda0fb77ca7b\",\"username\":\"carele\",\"nickname\":\"Carele\",\"avatar\":\"//image.lceda.cn/avatars/2024/7/ugQSCJo2x80pyZIIgzXIizMsNWlmvKa19drQSUuS.png\"},\"like\":0,\"is_like\":false},{\"uuid\":\"4643ab8525cf4c498322b2a3193c4f69\",\"comment_uuid\":\"f0cbee4354b34d859df29ce8ba6e425d\",\"parent_uuid\":\"0a8d18401a8346da862c30c7b7952990\",\"content\":\"暂时没有，最近不做这块了，你看看开源平台的其他项目[emojis:发抖]\",\"creator\":{\"uuid\":\"bd44fc34722f4b89a8a7fda0fb77ca7b\",\"username\":\"carele\",\"nickname\":\"Carele\",\"avatar\":\"//image.lceda.cn/avatars/2024/7/ugQSCJo2x80pyZIIgzXIizMsNWlmvKa19drQSUuS.png\"},\"created_at\":\"2024-08-31 00:02:08\",\"to_user\":{\"uuid\":\"44c63b9cb2384fcbbef0a9b1094e1740\",\"username\":\"arrebol0505\",\"nickname\":\"Arrebol0505\",\"avatar\":\"/image/avatar-default.png\"},\"like\":0,\"is_like\":false},{\"uuid\":\"3cbf99b34aa143ac9d767659e42880cf\",\"comment_uuid\":\"f0cbee4354b34d859df29ce8ba6e425d\",\"parent_uuid\":\"0a8d18401a8346da862c30c7b7952990\",\"content\":\"注意EN的电流大小有限制要求的，改大20倍，<img title=\\\"点击查看大图\\\" src=\\\"https://image.lceda.cn/oshwhub/pullImage/625e55e78eb24d5aacd6b6ccea38206f.png\\\" alt=\\\"\\\" />\",\"creator\":{\"uuid\":\"bb064ef0ced24237b743824913994ea2\",\"username\":\"han1993\",\"nickname\":\"FG\",\"avatar\":\"//image.lceda.cn/avatars/2025/7/bMlayTmr9CjHUJs0B4TVfk7sv26mIG7T2QVfbKGV.webp\"},\"created_at\":\"2025-07-21 21:02:05\",\"to_user\":{\"uuid\":\"44c63b9cb2384fcbbef0a9b1094e1740\",\"username\":\"arrebol0505\",\"nickname\":\"Arrebol0505\",\"avatar\":\"/image/avatar-default.png\"},\"like\":0,\"is_like\":false}]},{\"uuid\":\"0a20ef09e0d54dcfbba03b61233e9ce8\",\"comment_uuid\":null,\"parent_uuid\":null,\"content\":\"uo 的公式，我没有计算明白啊，0.6 / 1*（1+33） =   0.017  求指教\",\"creator\":{\"uuid\":\"e1f9b8fb03c142dbbb03571516f8eef7\",\"username\":\"kqqnhzl\",\"nickname\":\"kqqnhzl\",\"avatar\":\"//image.lceda.cn/pullimage/PzaKH6CjnqSVDxKvya1MWeR3hPCG06BYNqwE8Ofw.jpeg\"},\"created_at\":\"2024-07-18 15:37:17\",\"like\":0,\"is_like\":false,\"replies\":[{\"uuid\":\"03da186af067403c8c0bd4842ef6eeab\",\"comment_uuid\":\"0a20ef09e0d54dcfbba03b61233e9ce8\",\"parent_uuid\":\"0a20ef09e0d54dcfbba03b61233e9ce8\",\"content\":\"其中VFB是0.6V，VOUT是你需要的输出电压，R1和R2满足这个比例，R1和R2不是UP设计的这个电路中的，是说明书中R1、R1分压<img title=\\\"点击查看大图\\\" src=\\\"//image.lceda.cn/oshwhub/ebcd081fb09542169147dc5564b40a76.png\\\" alt=\\\"\\\" />\",\"creator\":{\"uuid\":\"44c63b9cb2384fcbbef0a9b1094e1740\",\"username\":\"arrebol0505\",\"nickname\":\"Arrebol0505\",\"avatar\":\"/image/avatar-default.png\"},\"created_at\":\"2024-08-29 09:44:11\",\"to_user\":{\"uuid\":\"e1f9b8fb03c142dbbb03571516f8eef7\",\"username\":\"kqqnhzl\",\"nickname\":\"kqqnhzl\",\"avatar\":\"//image.lceda.cn/pullimage/PzaKH6CjnqSVDxKvya1MWeR3hPCG06BYNqwE8Ofw.jpeg\"},\"like\":0,\"is_like\":false}]},{\"uuid\":\"b8bededfcbd84d68b963c1b8e55a6af4\",\"parent_uuid\":null,\"comment_uuid\":null,\"creator\":{\"uuid\":\"28e8e9d7075240fd894a54c850999a56\",\"username\":\"nwsy\",\"nickname\":\"nwsy\",\"avatar\":\"https://lceda.cn/images/avatar-default.png?id=f119c61e3d5ce714b4b8\"},\"content\":\"输入电流最大多少啊\",\"created_at\":\"2024-05-19 05:07:17\",\"like\":0,\"is_like\":false,\"replies\":[{\"uuid\":\"28846b96f5f44276848b8df3141cc334\",\"parent_uuid\":\"b8bededfcbd84d68b963c1b8e55a6af4\",\"comment_uuid\":\"b8bededfcbd84d68b963c1b8e55a6af4\",\"creator\":{\"uuid\":\"bd44fc34722f4b89a8a7fda0fb77ca7b\",\"username\":\"carele\",\"nickname\":\"Carele\",\"avatar\":\"//image.lceda.cn/avatars/2024/7/ugQSCJo2x80pyZIIgzXIizMsNWlmvKa19drQSUuS.png\"},\"content\":\"mt2492只标记了输出最大2A，具体参考下手册\",\"created_at\":\"2024-05-19 11:14:11\",\"to_user\":{\"uuid\":\"28e8e9d7075240fd894a54c850999a56\",\"username\":\"nwsy\",\"nickname\":\"nwsy\",\"avatar\":\"https://lceda.cn/images/avatar-default.png?id=f119c61e3d5ce714b4b8\"},\"like\":0,\"is_like\":false}]},{\"uuid\":\"c6f8d9b7c69b4e769cc524d6c8e3a319\",\"parent_uuid\":null,\"comment_uuid\":null,\"creator\":{\"uuid\":\"9227a68032824947bd38ac093fac35e7\",\"username\":\"abc871699197\",\"nickname\":\"abc871699197\",\"avatar\":\"/image/avatar-default.png\"},\"content\":\"你好，请问这个输出电压能调到1V输出吗？\",\"created_at\":\"2024-02-27 18:31:34\",\"like\":0,\"is_like\":false,\"replies\":[{\"uuid\":\"a20c99c4c59642178f1272e6cbeeea83\",\"parent_uuid\":\"c6f8d9b7c69b4e769cc524d6c8e3a319\",\"comment_uuid\":\"c6f8d9b7c69b4e769cc524d6c8e3a319\",\"creator\":{\"uuid\":\"bd44fc34722f4b89a8a7fda0fb77ca7b\",\"username\":\"carele\",\"nickname\":\"Carele\",\"avatar\":\"//image.lceda.cn/avatars/2024/7/ugQSCJo2x80pyZIIgzXIizMsNWlmvKa19drQSUuS.png\"},\"content\":\"配好反馈电阻应该可以，不过没有试过\",\"created_at\":\"2024-03-03 20:08:05\",\"to_user\":{\"uuid\":\"9227a68032824947bd38ac093fac35e7\",\"username\":\"abc871699197\",\"nickname\":\"abc871699197\",\"avatar\":\"/image/avatar-default.png\"},\"like\":0,\"is_like\":false}]},{\"uuid\":\"5d13b63b7a7541a4a53e87165e6a11e4\",\"parent_uuid\":null,\"comment_uuid\":null,\"creator\":{\"uuid\":\"0de2c1a1dc5243938dbaa8ee8b77bd86\",\"username\":\"qvqiii\",\"nickname\":\"QVQIII\",\"avatar\":\"//image.lceda.cn/pullimage/D2QXE6SikThzm4SwN9x9bf8fqSnw7WkMZQ5TVZSL.jpeg\"},\"content\":\"输入最大电压还有输出功率多大\",\"created_at\":\"2024-01-13 21:44:08\",\"like\":0,\"is_like\":false,\"replies\":[{\"uuid\":\"52e95be271724f1f9e9390ae10691dc7\",\"parent_uuid\":\"5d13b63b7a7541a4a53e87165e6a11e4\",\"comment_uuid\":\"5d13b63b7a7541a4a53e87165e6a11e4\",\"creator\":{\"uuid\":\"bd44fc34722f4b89a8a7fda0fb77ca7b\",\"username\":\"carele\",\"nickname\":\"Carele\",\"avatar\":\"//image.lceda.cn/avatars/2024/7/ugQSCJo2x80pyZIIgzXIizMsNWlmvKa19drQSUuS.png\"},\"content\":\"输入电压最高16V，输出电流最大2A\",\"created_at\":\"2024-03-03 20:09:09\",\"to_user\":{\"uuid\":\"0de2c1a1dc5243938dbaa8ee8b77bd86\",\"username\":\"qvqiii\",\"nickname\":\"QVQIII\",\"avatar\":\"//image.lceda.cn/pullimage/D2QXE6SikThzm4SwN9x9bf8fqSnw7WkMZQ5TVZSL.jpeg\"},\"like\":1,\"is_like\":false}]}]}}"},"redirectURL":"","headersSize":-1,"bodySize":-1,"_transferSize":3826,"_error":null,"_fetchedViaServiceWorker":false},"serverIPAddress":"REMOVED","startedDateTime":"2026-10-18T15:58:44.164Z","time":133.5409999883268,"timings":{"blocked":1.9519999903002754,"dns":-1,"ssl":-1,"connect":-1,"send":0.2230000000000001,"wait":109.9059999944549,"receive":21.460000003571622,"_blocked_queueing":0.9599999903002754,"_workerStart":-1,"_workerReady":-1,"_workerFetchStart":-1,"_workerRespondWithSettled":-1}},{"_fromCache":"memory","_initiator":{"type":"script","stack":{"callFrames":[{"functionName":"sY","scriptId":"196","url":"https://static.oshwhub.com/web/oshwhub/_next/static/chunks/fd9d1056-96f2ce78ff3bc886.js","lineNumber":0,"columnNumber":147265},{"functionName":"sG","scriptId":"196","url":"https://static.oshwhub.com/web/oshwhub/_next/static/chunks/fd9d1056-96f2ce78ff3bc886.js","lineNumber":0,"columnNumber":15