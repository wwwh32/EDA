cation/json, text/plain, */*"},{"name":"accept-encoding","value":"gzip, deflate, br, zstd"},{"name":"accept-language","value":"zh-CN,zh;q=0.9,zh-TW;q=0.8"},{"name":"priority","value":"u=1, i"},{"name":"referer","value":"https://oshwhub.com/carele/ji-yu-MT2492de-mi-ni-Buckxiang-ya-mu-kuai"},{"name":"sec-ch-ua","value":"\"Not A(Brand\";v=\"8\", \"Chromium\";v=\"132\", \"Google Chrome\";v=\"132\""},{"name":"sec-ch-ua-mobile","value":"REMOVED"},{"name":"sec-ch-ua-platform","value":"\"Windows\""},{"name":"sec-fetch-dest","value":"empty"},{"name":"sec-fetch-mode","value":"cors"},{"name":"sec-fetch-site","value":"same-origin"},{"name":"user-agent","value":"Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/132.0.0.0 Safari/537.36"}],"queryString":[],"cookies":[],"headersSize":-1,"bodySize":0},"response":{"status":200,"statusText":"","httpVersion":"http/2.0","headers":[{"name":"content-encoding","value":"br"},{"name":"content-type","value":"application/json"},{"name":"date","value":"Sun, 18 Oct 2026 15:58:59 GMT"},{"name":"j-trace-id","value":"1a4aa12e64034931baaed4d2530c13a7"},{"name":"server","value":"CW"},{"name":"strict-transport-security","value":"max-age=86400"},{"name":"via","value":"CHN-SH-CT13-CACHE30[49],CHN-SH-CT13-CACHE30[ovl,47]"},{"name":"x-ccdn-req-id-46b1","value":"5cc387682dfb0ad36b180533677d1f30"},{"name":"x-request-id","value":"X-LC-ID-DCDDzfsUekKzAA=="}],"cookies":[],"content":{"size":22505,"mimeType":"application/json","text":"{\"success\":true,\"code\":0,\"result\":{\"page\":1,\"pageSize\":10,\"total\":5,\"totalPage\":1,\"lists\":[{\"uuid\":\"17191893227d451299aa6a7ed16c7a48\",\"name\":\"造点“硬”的 · 创出“七”迹\",\"path\":\"seventh\",\"type\":2,\"prefix\":\"\",\"project_default_image\":\"https://image.lceda.cn/oshwhub/pullImage/24dc104c6f4a4f1a854ea42f6f93dfde.png\",\"grade\":100000,\"status\":1,\"registration_start_time\":\"2026-09-21T16:00:00.000Z\",\"registration_end_time\":\"2026-11-23T16:00:00.000Z\",\"competing_start_time\":\"2026-09-21T16:00:00.000Z\",\"competing_end_time\":\"2026-11-24T16:00:00.000Z\",\"competition_origin\":\"oshwhub.com\",\"is_show\":1,\"index_show\":1,\"must_public\":1,\"transfer_code\":\"6872487A\",\"lock_project\":0,\"websiteSeo\":\"\",\"templateType\":\"1\",\"introduction\":\"<font color=\\\"#FFFFFF\\\"><font size=\\\"5px\\\"><b>嘉立创20周年系列丨立创开源七周年</b></font></font><font color=\\\"#B0E0E6\\\"><br /><br /><font color=\\\"#FFFFFF\\\"><font size=\\\"5px\\\"><b>邀请每一位硬件爱好者用代码和电路板！</b></font></font><font color=\\\"#B0E0E6\\\"><br /><br /><font color=\\\"#FFFFFF\\\"><font size=\\\"5px\\\"><b>我们一起造点“硬”的<br /></b></font></font><font color=\\\"#B0E0E6\\\"></font></font></font>\",\"activityRules\":\"（1）<a href=\\\"https://docs.qq.com/sheet/DTEZKY3hua1FCbEJL?no_promotion=1&amp%3Btab=BB08J2\\\"><font color=\\\"#3232CD\\\"><b>点击填写报名领券表</b></font></a><br /><br />（2）设计的板子里面需要有<font color=\\\"#FF0000\\\">立创开源平台成立七周年的logo</font><a href=\\\"https://image.lceda.cn/oshwhub/pullImage/2cd7947343bd473491d61fedc829f784.png\\\"><font color=\\\"#3232CD\\\"><b>【点击下载logo】</b></font></a><br /><br />（3）限使用<font color=\\\"#FF0000\\\">嘉立创EDA专业版</font>参与活动，标准版不支持，活动工程是默认开源<br /><br />（4）参加活动用户完成原理图和PCB设计即可获得优惠券支持，可选择<font color=\\\"#FF0000\\\">50元彩色丝印券、20-100元器件券、20-50元3D打印券</font><br /><br />（5）投稿项目须是原创项目，鼓励将符合活动主题的私有项目开源，无电路特性的项目不可投稿此活动，官方参考案例不可以进行复刻参赛<br /><br />（6）参考项目：生日蛋糕音乐盒、可点燃的电子蜡烛、周年灯光画<br /><br />（7）需在专属活动页创建工程，项目默认开源展示（自选开源协议），已开源项目官方有权在其新媒体平台宣传展示<br /><br />（8）评奖规则：采用官方评选，参与评选需要在活动期间内完成开源发布<br /><br />（9）活动群聊：<font color=\\\"#3232CD\\\"><b><a href=\\\"https://image.lceda.cn/oshwhub/pullImage/5a009999319d43d4a992c4ff0bc4e13d.png\\\"><b>【扫码进入交流群】</b></a></b></font><br /><br />（10）<a href=\\\"https://docs.qq.com/doc/DTHhPZEx4ZkVDaHdo?no_promotion=1\\\"><b>点击查看活动流程文档</b></a><br /><br />（11）本活动最终解释权归立创开源硬件平台所有\",\"posts\":[],\"news\":[],\"lock_project_delete\":1,\"editor_version\":\"pro\",\"awards\":[{\"title\":\"一等奖\",\"image\":\"https://image.lceda.cn/oshwhub/pullImage/f7a8275aa9404397b17cc96d564e3aa4.png\",\"description\":\"5000金豆 + 300元元器件券 + 嘉立创定制机械键盘 + 荣誉证书\",\"award_image\":\"https://image.lceda.cn/oshwhub/pullImage/fed4849424d14fb5825f7faa82eb25af.png\"},{\"title\":\"二等奖\",\"image\":\"https://image.lceda.cn/oshwhub/pullImage/08196e001bc34fb5b937dcefba3355db.png\",\"description\":\"3000金豆 + 200元元器件券 + 嘉立创定制双肩背包  + 荣誉证书\",\"award_image\":\"https://image.lceda.cn/oshwhub/pullImage/6369baf9cabf48d4989b442cb137a4e7.png\"},{\"title\":\"三等奖\",\"image\":\"https://image.lceda.cn/oshwhub/pullImage/0012ea045f8f43a6814eacd9006f8d51.png\",\"description\":\"1000金豆 + 100元元器件券 + 嘉立创定制马克杯  + 荣誉证书\",\"award_image\":\"https://image.lceda.cn/oshwhub/pullImage/95b8f44b8dac4799b5c07173aaac3c9b.png\"},{\"title\":\"鼓励奖\",\"image\":\"https://image.lceda.cn/oshwhub/pullImage/e342c9020c7544b1af1e12aeab5f6dd7.png\",\"description\":\"500金豆 + 50元元器件券\\n\",\"award_image\":\"https://image.lceda.cn/oshwhub/pullImage/4a53a6b1c31a4e36b3074ac730a12c58.png\"},{\"title\":\"结项奖\",\"image\":\"https://image.lceda.cn/oshwhub/pullImage/3e95cf84d709431ba510f5088d397382.png\",\"description\":\"结项就送：50元彩色丝印券+嘉立创20周年抽奖机会3次（开源结项即可领取）\",\"award_image\":\"https://image.lceda.cn/oshwhub/pullImage/9d2e72adfe054058bb8e1846c845a302.png\"},{\"title\":\"参赛奖\",\"image\":\"https://image.lceda.cn/oshwhub/pullImage/0561ee65c8e843cd9e095bc71902c173.png\",\"description\":\"元器件费：20-200元  50元彩色丝印券\\n3D外壳打印券：20-50元\",\"award_image\":\"https://image.lceda.cn/easyedaResource/images/a3458040750545e1accd29ef4f5423d1.png\"}],\"is_shareLink\":0,\"is_payment\":0,\"open_course\":0,\"course_link\":\"\",\"link_copy\":\"\",\"coupons\":[],\"process\":[{\"title\":\"报名活动\",\"image\":\"https://image.lceda.cn/easyedaResource/images/09ceafeed08e47ffba3fbf473f0c07e4.png\",\"description\":\"报名参赛\"},{\"title\":\"设计制作\",\"image\":\"https://image.lceda.cn/easyedaResource/images/ecb83302fe6d4d5fbbb132f7f5b4c828.png\",\"description\":\"开启电子设计\"},{\"title\":\"审核发券\",\"image\":\"https://image.lceda.cn/easyedaResource/images/7