plication/json, text/plain, */*"},{"name":"accept-encoding","value":"gzip, deflate, br, zstd"},{"name":"accept-language","value":"zh-CN,zh;q=0.9,zh-TW;q=0.8"},{"name":"priority","value":"u=1, i"},{"name":"referer","value":"https://oshwhub.com/search?wd=MT2492&jlc_vid=RVkIAwECRwQLBAECRFdcBlAARlAKVwdUFQUKAgYHE1ExVlNfRVJfUFxUR1JcUztWKAkaExQVTU5BCBcOAAkbBUoFGAw%3D"},{"name":"sec-ch-ua","value":"\"Not A(Brand\";v=\"8\", \"Chromium\";v=\"132\", \"Google Chrome\";v=\"132\""},{"name":"sec-ch-ua-mobile","value":"?0"},{"name":"sec-ch-ua-platform","value":"\"Windows\""},{"name":"sec-fetch-dest","value":"empty"},{"name":"sec-fetch-mode","value":"cors"},{"name":"sec-fetch-site","value":"same-origin"},{"name":"user-agent","value":"Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/132.0.0.0 Safari/537.36"}],"queryString":[],"cookies":[],"headersSize":-1,"bodySize":0},"response":{"status":200,"statusText":"","httpVersion":"http/2.0","headers":[{"name":"content-encoding","value":"br"},{"name":"content-type","value":"application/json"},{"name":"date","value":"Sun, 18 Oct 2026 10:16:13 GMT"},{"name":"j-trace-id","value":"2503167473f449b683b2a1f269b0ff0c"},{"name":"server","value":"CW"},{"name":"strict-transport-security","value":"max-age=86400"},{"name":"via","value":"CHN-SH-SSPedu3-CACHE2[112],CHN-SH-SSPedu3-CACHE2[ovl,110],CHN-SH-GLOBAL4-CACHE36[ovl,105]"},{"name":"x-ccdn-req-id-46b1","value":"387fda41508bfb5c2722b2f060eafa77"},{"name":"x-request-id","value":"X-LC-ID-ykS1MOgUekKdAA=="}],"cookies":[],"content":{"size":22505,"mimeType":"application/json","text":"{\"success\":true,\"code\":0,\"result\":{\"page\":1,\"pageSize\":10,\"total\":5,\"totalPage\":1,\"lists\":[{\"uuid\":\"17191893227d451299aa6a7ed16c7a48\",\"name\":\"造点“硬”的 · 创出“七”迹\",\"path\":\"seventh\",\"type\":2,\"prefix\":\"\",\"project_default_image\":\"https://image.lceda.cn/oshwhub/pullImage/24dc104c6f4a4f1a854ea42f6f93dfde.png\",\"grade\":100000,\"status\":1,\"registration_start_time\":\"2026-09-21T16:00:00.000Z\",\"registration_end_time\":\"2026-11-23T16:00:00.000Z\",\"competing_start_time\":\"2026-09-21T16:00:00.000Z\",\"competing_end_time\":\"2026-11-24T16:00:00.000Z\",\"competition_origin\":\"oshwhub.com\",\"is_show\":1,\"index_show\":1,\"must_public\":1,\"transfer_code\":\"6872487A\",\"lock_project\":0,\"websiteSeo\":\"\",\"templateType\":\"1\",\"introduction\":\"<font color=\\\"#FFFFFF\\\"><font size=\\\"5px\\\"><b>嘉立创20周年系列丨立创开源七周年</b></font></font><font color=\\\"#B0E0E6\\\"><br /><br /><font color=\\\"#FFFFFF\\\"><font size=\\\"5px\\\"><b>邀请每一位硬件爱好者用代码和电路板！</b></font></font><font color=\\\"#B0E0E6\\\"><br /><br /><font color=\\\"#FFFFFF\\\"><font size=\\\"5px\\\"><b>我们一起造点“硬”的<br /></b></font></font><font color=\\\"#B0E0E6\\\"></font></font></font>\",\"activityRules\":\"（1）<a href=\\\"https://docs.qq.com/sheet/DTEZKY3hua1FCbEJL?no_promotion=1&amp;tab=BB08J2\\\"><font color=\\\"#3232CD\\\"><b>点击填写报名领券表</b></font></a><br /><br />（2）设计的板子里面需要有<font color=\\\"#FF0000\\\">立创开源平台成立七周年的logo</font><a href=\\\"https://image.lceda.cn/oshwhub/pullImage/2cd7947343bd473491d61fedc829f784.png\\\"><font color=\\\"#3232CD\\\"><b>【点击下载logo】</b></font></a><br /><br />（3）限使用<font color=\\\"#FF0000\\\">嘉立创EDA专业版</font>参与活动，标准版不支持，活动工程是默认开源<br /><br />（4）参加活动用户完成原理图和PCB设计即可获得优惠券支持，可选择<font color=\\\"#FF0000\\\">50元彩色丝印券、20-100元器件券、20-50元3D打印券</font><br /><br />（5）投稿项目须是原创项目，鼓励将符合活动主题的私有项目开源，无电路特性的项目不可投稿此活动，官方参考案例不可以进行复刻参赛<br /><br />（6）参考项目：生日蛋糕音乐盒、可点燃的电子蜡烛、周年灯光画<br /><br />（7）需在专属活动页创建工程，项目默认开源展示（自选开源协议），已开源项目官方有权在其新媒体平台宣传展示<br /><br />（8）评奖规则：采用官方评选，参与评选需要在活动期间内完成开源发布<br /><br />（9）活动群聊：<font color=\\\"#3232CD\\\"><b><a href=\\\"https://image.lceda.cn/oshwhub/pullImage/5a009999319d43d4a992c4ff0bc4e13d.png\\\"><b>【扫码进入交流群】</b></a></b></font><br /><br />（10）<a href=\\\"https://docs.qq.com/doc/DTHhPZEx4ZkVDaHdo?no_promotion=1\\\"><b>点击查看活动流程文档</b></a><br /><br />（11）本活动最终解释权归立创开源硬件平台所有\",\"posts\":[],\"news\":[],\"lock_project_delete\":1,\"editor_version\"