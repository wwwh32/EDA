45fb8d875979510b5211"},{"name":"sec-ch-ua","value":"\"Not A(Brand\";v=\"8\", \"Chromium\";v=\"132\", \"Google Chrome\";v=\"132\""},{"name":"sec-ch-ua-mobile","value":"REMOVED"},{"name":"sec-ch-ua-platform","value":"\"Windows\""}],"queryString":[],"cookies":[],"headersSize":2217,"bodySize":0},"response":{"status":200,"statusText":"OK","httpVersion":"HTTP/1.1","headers":[{"name":"Connection","value":"keep-alive"},{"name":"Content-Encoding","value":"br"},{"name":"Content-Type","value":"application/json"},{"name":"Date","value":"Sun, 18 Oct 2026 15:53:48 GMT"},{"name":"Server","value":"CW"},{"name":"Transfer-Encoding","value":"chunked"},{"name":"X-CCDN-REQ-ID-46B1","value":"6abc5ce310cb2ae47a77654757fe69d5"},{"name":"j-trace-id","value":"5dab2ad9510c456085f6d4a928210bb3"},{"name":"via","value":"CHN-SH-CT13-CACHE8[72],CHN-SH-CT13-CACHE8[ovl,70]"}],"cookies":[],"content":{"size":3241,"mimeType":"application/json","compression":1435,"text":"{\"success\":true,\"code\":0,\"result\":{\"uuid\":\"d54b0d8e884945fb8d875979510b5211\",\"path\":\"carele/ji-yu-MT2492de-mi-ni-Buckxiang-ya-mu-kuai\",\"name\":\"基于MT2492的迷你Buck降压模块\",\"content\":\"掰断引脚可以贴片形式安装。\\n![1685893980235.jpg](//image.lceda.cn/pullimage/yb7iWPbfG1zZuh2YKk40GplMturVgCl0lMuaL69C.jpeg)\\n\\n![1685893980250.jpg](//image.lceda.cn/pullimage/0R3N0WMMkGlzgM2o6WYZPAcOZlhLduZCgzYYQybP.jpeg)\\n\\n![1685893980259.jpg](//image.lceda.cn/pullimage/vvkzG895O28gQVhtF1jxDpuyFQr0jQVSyTjrkvON.jpeg)\\n可以通过可调电阻R4进行电压调整。（R3和R4二选一焊接）\\n电压与可调电阻R4大小的关系如下：\\n![输出电压与可调电阻的关系.jpg](//image.lceda.cn/pullimage/VTa8APGOY95ezxOPscvjwLvlkApKS6czp8FiO7Qx.jpeg)\\n\\n分别测试1.8V，3.3V与5V的电压输出（12V输入），结果如下：\\n![1685893980288.jpg](//image.lceda.cn/pullimage/Mw2d7e7JwSmGPxhFVnudFyvOlp1NafCxJh92NPRm.jpeg)\\n\\n![1685893980278.jpg](//image.lceda.cn/pullimage/3Pddc6j4ljMqxADBWXRpgEf7fmoBbGulZkdp53Wy.jpeg)\\n\\n![1685893980268.jpg](//image.lceda.cn/pullimage/k40Gjx6Nq9f5r0beMzB1CzLuO1B3xfDPoxSOnjzA.jpeg)\\n（调整可调电阻得到电压结果有略微误差）\",\"introduction\":\"基于MT2492的迷你Buck降压模块，可以直插或贴片方式安装在PCB中。\",\"grade\":1,\"public\":true,\"license\":\"GPL 3.0\",\"text_editor_type\":\"markdown\",\"creator\":{\"uuid\":\"bd44fc34722f4b89a8a7fda0fb77ca7b\",\"username\":\"carele\",\"nickname\":\"Carele\",\"avatar\":\"//image.lceda.cn/avatars/2024/7/ugQSCJo2x80pyZIIgzXIizMsNWlmvKa19drQSUuS.png\"},\"owner\":{\"uuid\":\"bd44fc34722f4b89a8a7fda0fb77ca7b\",\"username\":\"carele\",\"nickname\":\"Carele\",\"avatar\":\"//image.lceda.cn/avatars/2024/7/ugQSCJo2x80pyZIIgzXIizMsNWlmvKa19drQSUuS.png\",\"team\":false},\"origin\":\"pro\",\"is_draft\":false,\"publish\":true,\"members\":[{\"uuid\":\"bd44fc34722f4b89a8a7fda0fb77ca7b\",\"username\":\"carele\",\"nickname\":\"Carele\",\"avatar\":\"//image.lceda.cn/avatars/2024/7/ugQSCJo2x80pyZIIgzXIizMsNWlmvKa19drQSUuS.png\",\"role\":1}],\"no\":0,\"archive\":false,\"allow_comment\":true,\"version\":\"\",\"thumb\":\"//image.lceda.cn/pullimage/P0mVIylg547xzHIHwAEy4JvtHkGi3v1sFEoL6mtx.jpeg\",\"competition_record_uuid\":\"2edc3d08199244dbb29b501a7295685a\",\"updated_at\":\"2023-05-22T07:22:17.000Z\",\"created_at\":\"2023-05-19 23:03:42\",\"oshwhub_publish_at\":\"2023-06-05 09:03:46\",\"store\":false,\"updated_time\":\"2026-10-18 23:51:15\",\"oshwhub_first_publish_at\":{\"$date\":{\"$numberLong\":\"1685927026000\"}},\"tags\":[],\"bom\":\"\",\"allowComment\":true,\"permissions\":[\"project.copy\",\"project.backup\",\"project.file.export\",\"project.document.copy\",\"project.attachment.download\",\"design.file.export\",\"manufacture.file.export\",\"structure.file.export\",\"report.file.export\"],\"must_public\":1,\"competition_name\":\"2023电赛训练营-电赛常用模块设计作业\",\"competition_path\":\"PCB4\",\"workspace_jump\":\"\",\"title\":\"基于MT2492的迷你Buck降压模块\",\"folder\":null,\"cbb_project\":false,\"boards\":[{\"sch\":\"985e4e87e1b2497d9c11ef4280a892f3\",\"name\":\"Board2\",\"pcb\":\"0b4b6e74a2774404b3f0e5a7f99ee985\"}],\"default_sheet\":\"\",\"block_symbol_attrs_groups\":{},\"modifier\":{\"uuid\":\"bd44fc34722f4b89a8a7fda0fb77ca7b\",\"username\":