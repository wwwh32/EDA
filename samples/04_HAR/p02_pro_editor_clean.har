njzA.jpeg)\\n（调整可调电阻得到电压结果有略微误差）\",\"introduction\":\"基于MT2492的迷你Buck降压模块，可以直插或贴片方式安装在PCB中。\",\"grade\":1,\"public\":true,\"license\":\"GPL 3.0\",\"text_editor_type\":\"markdown\",\"creator\":{\"uuid\":\"bd44fc34722f4b89a8a7fda0fb77ca7b\",\"username\":\"carele\",\"nickname\":\"Carele\",\"avatar\":\"//image.lceda.cn/avatars/2024/7/ugQSCJo2x80pyZIIgzXIizMsNWlmvKa19drQSUuS.png\"},\"owner\":{\"uuid\":\"bd44fc34722f4b89a8a7fda0fb77ca7b\",\"username\":\"carele\",\"nickname\":\"Carele\",\"avatar\":\"//image.lceda.cn/avatars/2024/7/ugQSCJo2x80pyZIIgzXIizMsNWlmvKa19drQSUuS.png\",\"team\":false},\"origin\":\"pro\",\"is_draft\":false,\"publish\":true,\"members\":[{\"uuid\":\"bd44fc34722f4b89a8a7fda0fb77ca7b\",\"username\":\"carele\",\"nickname\":\"Carele\",\"avatar\":\"//image.lceda.cn/avatars/2024/7/ugQSCJo2x80pyZIIgzXIizMsNWlmvKa19drQSUuS.png\",\"role\":1}],\"no\":0,\"archive\":false,\"allow_comment\":true,\"version\":\"\",\"thumb\":\"//image.lceda.cn/pullimage/P0mVIylg547xzHIHwAEy4JvtHkGi3v1sFEoL6mtx.jpeg\",\"competition_record_uuid\":\"2edc3d08199244dbb29b501a7295685a\",\"updated_at\":\"2023-05-22T07:22:17.000Z\",\"created_at\":\"2023-05-19 23:03:42\",\"oshwhub_publish_at\":\"2023-06-05 09:03:46\",\"store\":false,\"updated_time\":\"2026-10-18 23:51:15\",\"oshwhub_first_publish_at\":{\"$date\":{\"$numberLong\":\"1685927026000\"}},\"tags\":[],\"bom\":\"\",\"allowComment\":true,\"permissions\":[\"project.copy\",\"project.backup\",\"project.file.export\",\"project.document.copy\",\"project.attachment.download\",\"design.file.export\",\"manufacture.file.export\",\"structure.file.export\",\"report.file.export\"],\"must_public\":1,\"competition_name\":\"2023电赛训练营-电赛常用模块设计作业\",\"competition_path\":\"PCB4\",\"workspace_jump\":\"\",\"title\":\"基于MT2492的迷你Buck降压模块\",\"folder\":null,\"cbb_project\":false,\"boards\":[{\"sch\":\"985e4e87e1b2497d9c11ef4280a892f3\",\"name\":\"Board2\",\"pcb\":\"0b4b6e74a2774404b3f0e5a7f99ee985\"}],\"default_sheet\":\"\",\"block_symbol_attrs_groups\":{},\"